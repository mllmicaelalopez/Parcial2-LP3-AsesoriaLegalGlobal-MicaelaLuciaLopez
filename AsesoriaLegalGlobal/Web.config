<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <appSettings>
    <!--
      Desde .NET 4.5 los controles de validación (Guía 07) usan por defecto el modo "Unobtrusive",
      que necesita jQuery registrado en la aplicación. Como usamos la plantilla Vacío no hay jQuery,
      y sin esta línea la página tira el error:
      "UnobtrusiveValidationMode requiere ScriptResourceMapping para 'jquery'".
      Con "None" los validadores vuelven al modo clásico (el de la guía) y funcionan sin jQuery.
    -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!--
      maxRequestLength está en KB. El límite real para los documentos es 5 MB y lo controla
      MisDocumentos.aspx.cs con un mensaje claro. Acá se deja un margen (10240 KB = 10 MB) porque
      si este valor fuera exactamente 5 MB, un archivo más grande cortaría la petición antes de llegar
      al código C# y el usuario vería una página de error del servidor en vez de nuestro aviso.
    -->
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!--
          Los documentos subidos son privados de cada usuario. Con hiddenSegments el servidor
          responde "404 No encontrado" si alguien intenta abrir por URL algo dentro de Documentos/
          (por ejemplo /Documentos/otro_usuario/contrato.pdf). El código C# sí puede leer y
          guardar en la carpeta, porque accede por el disco y no por la web.
        -->
        <hiddenSegments>
          <add segment="Documentos" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>