<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="AsesoriaLegalGlobal.MasterPage" %>

<!DOCTYPE html>

<%-- Master Page (Guía 11) --%>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Asesoría Legal Global</title>
    <link href="css/estilos.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header class="encabezado">
            <img src="img/logo2.png" alt="Logo de Asesoría Legal Global" class="logo" />
            <div>
                <p class="nombre-empresa">Asesoría Legal Global</p>
                <p class="lema">Tus documentos legales, seguros y en un solo lugar</p>
            </div>
        </header>

        <%-- HyperLink (Guías 09 y 11) --%>
        <nav class="navbar">
            <asp:HyperLink ID="lnkInicio" runat="server" NavigateUrl="~/Default.aspx">Inicio</asp:HyperLink>
            <asp:HyperLink ID="lnkRegistro" runat="server" NavigateUrl="~/Registro.aspx">Registrarse</asp:HyperLink>
            <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx">Iniciar sesión</asp:HyperLink>
            <asp:HyperLink ID="lnkMisDocumentos" runat="server" NavigateUrl="~/MisDocumentos.aspx">Mis Documentos</asp:HyperLink>
            <asp:HyperLink ID="lnkCerrarSesion" runat="server" NavigateUrl="~/CerrarSesion.aspx">Cerrar sesión</asp:HyperLink>
            <asp:Label ID="lblSaludo" runat="server" CssClass="saludo"></asp:Label>
        </nav>

        <main class="contenido">
            <%-- ContentPlaceHolder y asp:Content (Guía 11) --%>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="pie">
            <img src="img/logo1.png" alt="Logo de Asesoría Legal Global" class="logo-pie" />
            <p class="copy">© 2026 Asesoría Legal Global</p>
            <p>Contacto: contacto@asesorialegalglobal.example · Tel. (0351) 555-0142</p>
        </footer>

    </form>
</body>
</html>
